# ── Telegram Bot (MAJBURIY) ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# my.telegram.org — Pyrogram (katta fayllar) + userbot
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# ── Ruxsat (whitelist) ────────────────────────────────────────────────────────
# Faqat shu ID lar botdan foydalanadi. Admin har doim ruxsatli.
ALLOWED_USER_IDS=123456789,987654321
ADMIN_USER_IDS=123456789

# ── Save Restricted (userbot) ─────────────────────────────────────────────────
# @session_string_bot dan olingan session
SESSION_STRING=

# ── Arxiv guruhi (forum topic) ────────────────────────────────────────────────
# Save qilinganda media shu guruhga, yangi topic ochib saqlanadi
ARCHIVE_GROUP_ID=-1001234567890
AUTO_CREATE_TOPIC=true

# ── Local Bot API (ixtiyoriy, 2GB+ fayllar) ───────────────────────────────────
# LOCAL_BOT_API_URL=http://local-bot-api.railway.internal:8081/bot

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Batch (ixtiyoriy, default 50)
# BATCH_MAX_FILES=50
